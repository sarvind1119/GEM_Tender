GROQ_API_KEY=your_key_here
TURNOVER_LLM_MODEL=llama-3.3-70b-versatile

# --- Registry verification (PAN / GSTIN / MCA) ---
# Master egress gate: HTTP calls to non-localhost hosts are refused unless true.
VERIFY_ENABLED=false
# Provider per service: mock (in-process fixtures) | http (VERIFY_<SVC>_BASE_URL)
VERIFY_PAN_PROVIDER=mock
VERIFY_GSTIN_PROVIDER=mock
VERIFY_MCA_PROVIDER=mock
# For http mode. Local mock server: python -m tools.verification.mock_server
# VERIFY_PAN_BASE_URL=http://127.0.0.1:8877/pan
# VERIFY_GSTIN_BASE_URL=http://127.0.0.1:8877/gstin
# VERIFY_MCA_BASE_URL=http://127.0.0.1:8877/mca/cin
VERIFY_PAN_BASE_URL=
VERIFY_PAN_API_KEY=
VERIFY_GSTIN_BASE_URL=
VERIFY_GSTIN_API_KEY=
VERIFY_MCA_BASE_URL=
VERIFY_MCA_API_KEY=
VERIFY_TIMEOUT_SECONDS=20
VERIFY_MOCK_SERVER_PORT=8877
